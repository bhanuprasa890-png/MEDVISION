# ==============================================================================
# MEDVISION — Comprehensive Git Ignore Configuration
# Combines project security boundaries with standard Python/Node/OS rules
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so
.Python

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller & Packaging Specs
*.manifest
*.spec

# Python Virtual Environments
env/
venv/
.venv/
backend/venv/
ENV/
env.bak/
venv.bak/
.pyenv/

# Node / Frontend Dependencies & Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
.npm
.eslintcache

# Logs, Diagnostics & Installer Outputs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt
pip-delete-this-directory.txt

# Environment Variables & Secrets (Keep .env.example templates tracked)
.env
.env.*
*.env
*.env.*
.envrc
.streamlit/secrets.toml
!.env.example
!*.env.example
!**/.env.example

# Certificates, Private Keys & Secret Tokens
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
*.token
secrets/

