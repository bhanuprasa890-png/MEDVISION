*.sqlite3-shm
medvision.db*
backend/medvision.db*
database/*.db*
database/*.sqlite*
database/*.sqlite3*
db.sqlite3
db.sqlite3-journal

# Local Backups, Disposable Copies & Scratch Files
*.bak
*.backup
*backup*.db
*backup*.sqlite
*restored*.db
*disposable*.db
*.old
*.orig
uploads/
backend/uploads/
scratch/
*.tmp

