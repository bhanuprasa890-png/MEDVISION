# ==============================================================================
# MedVision AI - Environment Configuration Example (Development)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY REMINDER:
# - Never commit real credentials, production secrets, or private keys to git.
# - Do not enable wildcard CORS origins in production.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="MedVision AI - Explainable Medical Imaging Research Assistant"
VERSION=0.1.0-alpha
DEBUG=True

# API Configuration
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000

# Strict Local Development CORS (Only allow local Vite frontend)
# Format: JSON array of strings
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Connection (SQLite local file for hackathon development)
DATABASE_URL=sqlite:///./medvision.db

# File Upload Security Constraints
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
ALLOWED_FILE_EXTENSIONS=[".jpg",".jpeg",".png",".webp"]

# MedAssist Health-Education Chatbot (Optional genuine LLM integration)
# Primary provider: Google Gemini (default recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional Secondary Fallback Provider (OpenAI-compatible)
# When configured, MedAssist automatically fails over to this provider during primary 503/transient outages
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=

# Provider Resilience, Timeouts & Bounded Retry Policy
MEDASSIST_TIMEOUT_SECONDS=30.0
MEDASSIST_OVERALL_TIMEOUT_SECONDS=60.0
MEDASSIST_MAX_RETRIES=2
MEDASSIST_RETRY_INITIAL_DELAY=1.0
MEDASSIST_RETRY_MAX_DELAY=8.0
MEDASSIST_RETRY_JITTER=true
MEDASSIST_ENABLE_FALLBACK=true

# Frontend Configuration (Used by Vite during development)
VITE_API_BASE_URL=http://localhost:8000

