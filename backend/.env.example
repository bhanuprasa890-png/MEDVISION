# ==============================================================================
# MedVision AI Backend - Environment Configuration Example (Development)
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="MedVision AI Backend"
VERSION=0.1.0-alpha
DEBUG=True

# API Configuration
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000

# CORS Configuration: Only allow the local Vite frontend
# JSON array formatted string
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Connection (SQLite local file)
DATABASE_URL=sqlite:///./medvision.db

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
ALLOWED_FILE_EXTENSIONS=[".jpg",".jpeg",".png",".webp"]

# MedAssist Health-Education Chatbot (Optional genuine LLM integration)
# Primary provider: Google Gemini (default recommended)
# Set GEMINI_API_KEY to activate conversational assistance.
# If omitted, MedAssist responds with a safe, honest 503 service unavailable response.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional Secondary Fallback Provider (OpenAI-compatible)
# When configured, MedAssist automatically fails over to this provider during primary 503/transient outages
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=

# Provider Resilience, Timeouts & Bounded Retry Policy
MEDASSIST_TIMEOUT_SECONDS=30.0
MEDASSIST_OVERALL_TIMEOUT_SECONDS=60.0
MEDASSIST_MAX_RETRIES=2
MEDASSIST_RETRY_INITIAL_DELAY=1.0
MEDASSIST_RETRY_MAX_DELAY=8.0
MEDASSIST_RETRY_JITTER=true
MEDASSIST_ENABLE_FALLBACK=true
