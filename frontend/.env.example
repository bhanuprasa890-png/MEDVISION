# ==============================================================================
# MedVision AI Frontend - Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development or set during production build:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY REMINDER:
# - Vite embeds variables starting with VITE_ into the static client JavaScript bundle.
# - NEVER put secret API keys, database credentials, or private tokens in this file!
# ==============================================================================

# Backend API Base URL
# Development default:
VITE_API_BASE_URL=http://localhost:8000

# Production example (replace with your domain/reverse proxy):
# VITE_API_BASE_URL=https://api.medvision.yourdomain.com
